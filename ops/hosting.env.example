# Copy to /etc/hosting/hosting.env, owned by root with permissions 600.
# This file is sourced by Bash: quote values, and do not add spaces around =.
HOSTING_PROJECT=/opt/hosting/apps/demo
PUBLIC_URL=https://your-domain.example/health
# Configure an existing encrypted restic repository outside this server.
RESTIC_REPOSITORY='sftp:backup-user@backup-host:/backups/hosting'
RESTIC_PASSWORD_FILE=/etc/hosting/restic-password
# Optional provider credentials (e.g. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY)
# can be added here. Never commit the populated file.
DISK_THRESHOLD=85
MEMORY_THRESHOLD=90
BACKUP_MAX_AGE_HOURS=30
# Optional HTTPS endpoint accepting JSON {"text":"..."}; empty = journal only.
ALERT_WEBHOOK=''
